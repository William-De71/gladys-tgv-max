  "description": {
    "en": "MAX JEUNE and MAX SENIOR seats on your SNCF routes, and an alert when seats open.",
    "fr": "Places MAX JEUNE et MAX SENIOR sur vos trajets SNCF, et alerte quand des places s’ouvrent.",
    "de": "MAX-JEUNE- und MAX-SENIOR-Plätze auf Ihren SNCF-Strecken, mit Alarm bei neuen Plätzen.",
    "es": "Plazas MAX JEUNE y MAX SENIOR en sus trayectos SNCF, y aviso cuando se abren plazas."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/william-de71/gladys-tgv-max:0.1.0",
  "gladys_version": ">=5.3.0",
  "categories": ["transport"],
  "keywords": [
    "tgvmax",
    "max jeune",
    "max senior",
    "sncf",
    "tgv inoui",
    "intercités",
